                        style: TextStyle(color: Colors.white70, fontSize: 11, height: 1.6),
                      ),
                      const SizedBox(height: 20),
                      FilledButton(
                        onPressed: () => message(context, 'AI camera integration required.'),
                        style: FilledButton.styleFrom(backgroundColor: Colors.white, foregroundColor: purple),
                        child: const Text('Start AI Scan'),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 25),
                Row(
                  children: [
                    const Expanded(
                      child: Text(
                        'Manual Fit Profile',
                        style: TextStyle(color: dark, fontWeight: FontWeight.w900, fontSize: 21),
                      ),
                    ),
                    SegmentedButton<bool>(
                      segments: const [
                        ButtonSegment(value: true, label: Text('cm')),
                        ButtonSegment(value: false, label: Text('in')),
                      ],
                      selected: {metric},
                      onSelectionChanged: (v) => setState(() => metric = v.first),
                    ),
                  ],
                ),
                const SizedBox(height: 10),
                const Text(
                  'Sample values. Replace them with measurements you enter.',
                  style: TextStyle(color: muted, fontSize: 11),
                ),
              ],
            ),
          ),
        ),
        SliverPadding(
          padding: const EdgeInsets.symmetric(horizontal: 20),
          sliver: SliverList(
            delegate: SliverChildBuilderDelegate(
              (context, index) {
                final name = values.keys.elementAt(index);
                final value = values[name]!;
                final display = metric ? value : value / 2.54;

                return Container(
                  margin: const EdgeInsets.only(bottom: 12),
                  padding: const EdgeInsets.all(16),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(20),
                  ),
                  child: Column(
                    children: [
                      Row(
                        children: [
                          Text(name, style: const TextStyle(color: dark, fontWeight: FontWeight.bold)),
                          const Spacer(),
                          Text(
                            '${display.toStringAsFixed(1)} ${metric ? "cm" : "in"}',
                            style: const TextStyle(color: purple, fontWeight: FontWeight.w900),
                          ),
                        ],
                      ),
                      Slider(
                        value: value,
                        min: 20,
                        max: 150,
                        activeColor: purple,
                        onChanged: (v) => setState(() => values[name] = v),
                      ),
                    ],
                  ),
                );
              },
              childCount: values.length,
            ),
          ),
        ),
        SliverToBoxAdapter(
          child: Padding(
            padding: const EdgeInsets.fromLTRB(20, 10, 20, 30),
            child: PrimaryButton(
              text: 'Save My Fit Profile',
              onPressed: () => message(context, 'Profile saved in this demo session.'),
            ),
          ),
        ),
      ],
    );
  }
}

